// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  password       String? // Optional for guest users
  name           String?
  phone          String?
  role           String               @default("USER") // USER, ADMIN
  sessionVersion Int                  @default(0)
  mfaSecretEncrypted String?
  mfaEnabledAt DateTime?
  mfaLastUsedStep Int?
  mfaRecoveryCodesJson String @default("[]") @db.NVarChar(Max)
  mfaPendingSecretEncrypted String?
  mfaPendingExpiresAt DateTime?
  /// Language for mail the salon sends when no page supplies one (e.g. a
  /// booking an administrator enters). en-GB or zh-HK; null means en-GB.
  preferredLocale String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  appointments   Appointment[]
  reviews        Review[]
  oauthAccounts  OAuthAccount[]
  passwordResets PasswordResetToken[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@unique([provider, userId])
  @@index([userId])
}

model Stylist {
  id                  String               @id @default(cuid())
  name                String
  bio                 String?
  imageUrl            String?
  role                String
  slug                String?              @unique
  tagline             String?
  specialtiesJson     String               @default("[]")
  languagesJson       String               @default("[]")
  yearsExperience     Int?
  trainedIn           String?
  extendedBioJson     String               @default("[]")
  treatwellIcalUrl    String? // Treatwell Connect per-staff iCal feed URL (Phase 1 inbound sync)
  treatwellExternalId String? // Treatwell API staff/resource id (Phase 2 outbound sync)
  icalToken           String?              @unique // secret for this stylist's outbound busy-feed URL
  /// Retired staff stay in the database because their past appointments must
  /// survive (Appointment.stylist is onDelete: Restrict). Inactive stylists are
  /// hidden from the public site, the booking flow and the sync-coverage gate —
  /// otherwise a retired stylist with no opening hours would block booking for
  /// everyone. Admin screens still list them.
  isActive            Boolean              @default(true)
  calendarColor       String? // admin calendar palette key (see lib/calendar-colors.ts); admin-only, never public
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  appointments        Appointment[]
  availabilities      Availability[]
  employee            Employee?
  externalBusyBlocks  ExternalBusyBlock[]
  calendarConnections CalendarConnection[]
}

model Service {
  id                   String        @id @default(cuid())
  name                 String
  description          String?
  price                Decimal
  duration             Int // in minutes
  category             String // e.g., Cut, Color, Treatment
  calendarColor        String? // admin calendar palette key — drives the stripe on a booking block
  requiresPatchTest    Boolean       @default(false)
  isPatchTest          Boolean       @default(false)
  requiresConsultation Boolean       @default(false)
  isConsultation       Boolean       @default(false)
  imageUrl             String?
  treatwellExternalId  String? // Treatwell API service/menu-item id
  /// Groups the length/price-type options of one menu item. Pricing never
  /// matches names: the standard/NHS pair is (offeringId, hairLength, priceType).
  offeringId           String?
  offering             ServiceOffering? @relation(fields: [offeringId], references: [id], onDelete: SetNull)
  hairLength           String? // SHORT, MEDIUM, LONG, EXTRA_LONG; null when the item has no length options
  priceType            String        @default("STANDARD") // STANDARD, NHS
  /// Listed on public pages. A retired option stays in the table so past
  /// appointments keep their relation, but leaves every listing.
  isPublic             Boolean       @default(true)
  /// Accepts NEW bookings (customer or admin). Existing appointments are managed
  /// regardless, under the usual cancellation/reschedule policy.
  isBookable           Boolean       @default(true)
  /// Bumped on every price change; quotes carry it so a stale confirm is caught.
  priceVersion         Int           @default(1)
  vatDisplay           String        @default("UNSPECIFIED") // EXCLUDED, UNSPECIFIED
  priceNature          String        @default("LISTED") // LISTED, SUBJECT_TO_CONSULTATION
  durationConfirmed    Boolean       @default(true)
  /// A composite option priced as another option plus a fixed surcharge
  /// (full-head colour extra long = long-hair price + £37 "Adds Extra Long").
  surchargeBaseServiceId String?
  surchargeBase        Service?      @relation("ServiceSurcharge", fields: [surchargeBaseServiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  surchargeDependents  Service[]     @relation("ServiceSurcharge")
  surchargeAmount      Decimal?
  /// Published English fine print shown beside the price (zh-HK lives in ContentTranslation).
  priceNote            String? @db.NVarChar(Max)
  priceSource          String? // e.g. "treatwell:2026-09-28" — see prisma/price-catalog
  priceVerifiedAt      DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  appointments         Appointment[]

  @@index([offeringId])
  @@index([isPublic, category])
}

/// One menu item whose options (hair length × standard/NHS) are Service rows.
model ServiceOffering {
  id           String    @id @default(cuid())
  key          String    @unique // stable, never translated, e.g. "full-head-colour"
  category     String
  name         String
  description  String? @db.NVarChar(Max)
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  services     Service[]
}

model Appointment {
  id                  String    @id @default(cuid())
  date                DateTime
  status              String    @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  notes               String?
  priceAtBooking      Decimal?
  durationAtBooking   Int?
  /// Versioned server quote (see services/pricing/quote.ts). Null on bookings
  /// made before quotes existed: their price type and VAT basis are UNKNOWN.
  quoteJson           String? @db.NVarChar(Max)
  /// Customer mail language fixed when the booking was made; null means en-GB.
  notificationLocale  String?
  reminderSent        Boolean   @default(false)
  reviewRequestSent   Boolean   @default(false)
  treatwellBookingId  String?
  treatwellSyncStatus String    @default("NOT_REQUIRED") // NOT_REQUIRED, PENDING, SYNCED, FAILED
  treatwellSyncError  String?
  treatwellSyncedAt   DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stylistId String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: NoAction)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id], onDelete: NoAction)

  discountCodeId String?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id], onDelete: SetNull)

  notificationVersion Int                    @default(0)
  notifications       NotificationDelivery[]

  review Review?

  @@index([stylistId, date])
  @@index([userId, status])
  @@index([userId, date, id])
  @@index([status, date, id])
  @@index([status, reminderSent, date])
  @@index([status, reviewRequestSent, date])
  @@index([treatwellSyncStatus, updatedAt])
  @@index([date])
}

model ExternalBusyBlock {
  id          String   @id @default(cuid())
  source      String   @default("TREATWELL") @db.NVarChar(50) // TREATWELL (future: other channels)
  externalUid String   @db.NVarChar(400) // iCal VEVENT UID — natural key for upsert/dedup
  stylistId   String
  stylist     Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  start       DateTime
  end         DateTime
  summary     String? // raw event title, for debugging only
  lastSyncAt  DateTime @default(now())

  @@unique([source, stylistId, externalUid])
  @@index([stylistId, start])
  @@index([end])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int // 1-5
  comment   String?
  status    String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model Availability {
  id        String  @id @default(cuid())
  dayOfWeek Int // 0-6 (Sun-Sat)
  startTime String // HH:mm
  endTime   String // HH:mm
  isOff     Boolean @default(false)

  stylistId String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
}

model DiscountCode {
  id           String        @id @default(cuid())
  code         String        @unique
  type         String // PERCENTAGE, FIXED
  value        Decimal
  maxUses      Int? // null means unlimited
  usedCount    Int           @default(0)
  expiresAt    DateTime?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  appointments Appointment[]
}

model Offer {
  id            String   @id @default(cuid())
  title         String
  description   String?
  discountType  String // PERCENTAGE, FIXED
  discountValue Decimal
  isActive      Boolean  @default(true)
  isGlobal      Boolean  @default(false) // If true, applies to all services automatically
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ServiceCategoryContent {
  id              String   @id @default(cuid())
  slug            String   @unique
  category        String   @unique
  title           String
  hero            String
  metaDescription String
  intro           String
  overviewJson    String
  includesJson    String
  processJson     String
  aftercareJson   String
  faqsJson        String
  relatedSlugs    String   @default("")
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SiteSettings {
  id                String   @id @default("singleton")
  phone             String   @default("07831 830898")
  twitterHandle     String   @default("")
  gscVerification   String   @default("")
  googleBusinessUrl String   @default("https://www.google.com/maps/place/Harbour+Hair/data=!4m2!3m1!1s0x0:0xad74be12e1f34d1a?sa=X&ved=1t:2428&ictx=111")
  facebookUrl       String   @default("")
  instagramUrl      String   @default("https://www.instagram.com/harbourhair_leeds/")
  treatwellUrl      String   @default("https://www.treatwell.co.uk/place/harbour-hair-hk-hair-stylist/")
  freshaUrl         String   @default("")
  booksyUrl         String   @default("")
  heroEyebrow       String   @default("Leeds City Centre")
  heroTitleLine1    String   @default("Expert Hair")
  heroTitleLine2    String   @default("Styling")
  heroSubtitle      String   @default("Tailored cuts, colours and grooming by Hong Kong trained stylists. Precision and artistry in every appointment.")
  // Online-booking master switch, toggled from Admin -> Settings. Defaults to
  // FALSE (booking closed) so a fresh environment can never accidentally take
  // bookings before Treatwell two-way sync is configured.
  bookingEnabled    Boolean  @default(false)
  /// Language of the salon's own notification mails (new booking alerts).
  salonNotificationLocale String @default("zh-HK")
  updatedAt         DateTime @updatedAt
}

model Faq {
  id        String   @id @default(cuid())
  key       String
  question  String
  answer    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key, sortOrder])
}

model BlogPost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String
  excerpt      String
  author       String
  authorRole   String
  publishedAt  DateTime
  readingTime  Int      @default(5)
  tags         String   @default("")
  coverImage   String
  coverAlt     String
  lede         String
  sectionsJson String
  relatedSlugs String   @default("")
  status       String   @default("DRAFT")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, publishedAt])
}

model Employee {
  id                     String   @id @default(cuid())
  name                   String
  title                  String // e.g. "Senior Stylist", "Receptionist"
  pinHash                String
  payType                String   @default("HOURLY") // HOURLY, SALARY, COMMISSION, HYBRID
  hourlyRate             Decimal?
  monthlySalary          Decimal?
  commissionRate         Decimal? // fraction, e.g. 0.40 = 40%
  overtimeEnabled        Boolean  @default(false)
  overtimeThresholdHours Decimal? // hours per pay period (one month) before overtime
  overtimeMultiplier     Decimal? // e.g. 1.5
  unpaidBreakMinutes     Int? // fixed unpaid break minutes, auto-deducted per worked day; use this OR per-entry break edits, not both
  isActive               Boolean  @default(true)
  hireDate               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  stylistId String?  @unique
  stylist   Stylist? @relation(fields: [stylistId], references: [id], onDelete: SetNull)

  timeEntries  TimeEntry[]
  payrollLines PayrollLine[]
  shifts       Shift[]

  @@index([isActive])
}

model TimeEntry {
  id              String    @id @default(cuid())
  employeeId      String
  employee        Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  clockIn         DateTime
  clockOut        DateTime?
  breakMinutes    Int       @default(0)
  source          String    @default("KIOSK") // KIOSK, ADMIN
  status          String    @default("PENDING") // OPEN, PENDING, APPROVED, EDITED
  note            String?
  editedByAdminId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([employeeId, clockIn])
  @@index([status, clockIn])
}

model PayrollPeriod {
  id                 String    @id @default(cuid())
  year               Int
  month              Int // 1-12
  status             String    @default("DRAFT") // DRAFT, FINALIZED
  finalizedByAdminId String?
  finalizedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  lines PayrollLine[]

  @@unique([year, month])
}

model PayrollLine {
  id                    String        @id @default(cuid())
  periodId              String
  period                PayrollPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  employeeId            String
  employee              Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  totalHours            Decimal       @default(0)
  regularHours          Decimal       @default(0)
  overtimeHours         Decimal       @default(0)
  basePay               Decimal       @default(0)
  overtimePay           Decimal       @default(0)
  commissionableRevenue Decimal       @default(0)
  commissionPay         Decimal       @default(0)
  adjustments           Decimal       @default(0)
  adjustmentNote        String?
  grossPay              Decimal       @default(0)
  snapshotJson          String        @default("")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@unique([periodId, employeeId])
}

model Shift {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime // salon-local calendar date, stored as that day's UTC midnight
  startTime  String // HH:mm (salon local)
  endTime    String // HH:mm (salon local)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId, date])
  @@index([date])
}

// Single-use password reset grants. Only the SHA-256 hash of the token is
// stored, so a database leak cannot be replayed against the reset endpoint.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.VarChar(64)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// A provider's sales activity is independent of its public marketing link.
model CalendarConnection {
  id                  String    @id @default(cuid())
  stylistId           String
  stylist             Stylist   @relation(fields: [stylistId], references: [id], onDelete: Cascade)
  provider            String
  receivesBookings    Boolean   @default(false)
  inboundUrl          String?   @db.NVarChar(Max)
  inboundEnabled      Boolean   @default(false)
  outboundConfirmedAt DateTime?
  lastAttemptAt       DateTime?
  lastSuccessAt       DateTime?
  lastError           String?   @db.NVarChar(Max)
  lockedUntil         DateTime?
  lockToken           String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([stylistId, provider])
  @@index([inboundEnabled])
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  eventKey       String       @unique
  kind           String
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id], onDelete: NoAction)
  payloadJson    String       @db.NVarChar(Max)
  status         String       @default("PENDING")
  attempts       Int          @default(0)
  firstAttemptAt DateTime?
  nextAttemptAt  DateTime     @default(now())
  lockedAt       DateTime?
  lockToken      String?
  sentAt         DateTime?
  lastError      String?      @db.NVarChar(Max)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, nextAttemptAt])
  @@index([appointmentId, kind])
  @@index([status, lockedAt])
  @@index([status, createdAt])
}

model BackgroundJobState {
  name            String    @id
  lastStartedAt   DateTime?
  lastSucceededAt DateTime?
  lastFailedAt    DateTime?
  lastError       String?   @db.NVarChar(Max)
  lastResultJson  String?   @db.NVarChar(Max)
  lockToken       String?
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt
}

// Revocable device grants; legacy stateless kiosk tokens must be re-enabled.
model KioskSession {
  id               String    @id @default(cuid()) @db.NVarChar(128)
  deviceName       String    @default("Salon kiosk") @db.NVarChar(128)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdByAdminId String? @db.NVarChar(128)

  @@index([revokedAt, expiresAt])
}

// Application writes append events; no general update/delete interface is exposed.
model AuditEvent {
  id           String   @id @default(cuid()) @db.NVarChar(128)
  actorUserId  String? @db.NVarChar(128)
  action       String @db.NVarChar(128)
  targetType   String @db.NVarChar(64)
  targetId     String? @db.NVarChar(128)
  metadataJson String   @default("{}") @db.NVarChar(Max)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

/// Published copy of one entity's translatable fields in one locale. Written
/// only by the publish step, for both locales in the same transaction, so the
/// two languages always show the same revision. English is ALSO mirrored into
/// the entity's own columns, which is what English pages read.
model ContentTranslation {
  id                 String   @id @default(cuid())
  entityType         String // SERVICE, SERVICE_OFFERING, CATEGORY_CONTENT, FAQ, BLOG_POST, STYLIST, OFFER, SITE_SETTINGS
  entityId           String
  locale             String // en-GB, zh-HK
  fieldsJson         String @db.NVarChar(Max)
  revision           Int
  publishedAt        DateTime @default(now())
  publishedByAdminId String?

  @@unique([entityType, entityId, locale])
  @@index([entityType, locale])
}

/// Unpublished edits to an entity's translatable fields, both languages in one
/// row. Saving a draft never touches what the public site shows.
model ContentDraft {
  id               String   @id @default(cuid())
  entityType       String
  entityId         String
  baseRevision     Int      @default(0) // published revision the draft started from
  fieldsJson       String @db.NVarChar(Max) // { "en-GB": {...}, "zh-HK": {...} }
  reviewJson       String   @default("{}") @db.NVarChar(Max) // per-locale proofreading marks, see content-review.ts
  sharedJson       String   @default("{}") @db.NVarChar(Max) // non-text fields published with the text (service price)
  updatedByAdminId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([entityType, entityId])
}
