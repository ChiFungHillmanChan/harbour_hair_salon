{
  "name": "harbour_hair_salon",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "vercel-build": "node scripts/production-build-guard.mjs && if [ \"$VERCEL_ENV\" = \"production\" ]; then prisma migrate deploy --schema prisma/vercel/schema.prisma; else echo \"Skipping migrations (VERCEL_ENV=$VERCEL_ENV) \u2014 only production may mutate the schema\"; fi && next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "node --conditions=react-server --import tsx --test $(find src -name '*.test.ts')",
    "test:square": "node --conditions=react-server --import tsx --test src/app/lib/square-config.test.ts src/app/lib/square-webhook.test.ts src/app/services/deposit-policy.test.ts src/app/services/square-gateway.test.ts",
    "db:switch:dev": "prisma generate --schema prisma/dev/schema.prisma",
    "db:switch:prod": "prisma generate --schema prisma/prod/schema.prisma",
    "db:dev:migrate": "prisma migrate dev --schema prisma/dev/schema.prisma",
    "db:dev:push": "prisma db push --schema prisma/dev/schema.prisma",
    "db:dev:studio": "prisma studio --schema prisma/dev/schema.prisma",
    "db:dev:generate": "prisma generate --schema prisma/dev/schema.prisma",
    "db:prod:migrate": "prisma migrate dev --schema prisma/prod/schema.prisma",
    "db:prod:deploy": "prisma migrate deploy --schema prisma/prod/schema.prisma",
    "db:prod:push": "prisma db push --schema prisma/prod/schema.prisma",
    "db:prod:generate": "prisma generate --schema prisma/prod/schema.prisma",
    "postinstall": "prisma generate --schema prisma/vercel/schema.prisma",
    "db:vercel:generate": "prisma generate --schema prisma/vercel/schema.prisma",
    "db:vercel:migrate": "prisma migrate dev --schema prisma/vercel/schema.prisma",
    "db:vercel:deploy": "prisma migrate deploy --schema prisma/vercel/schema.prisma",
    "db:vercel:baseline": "prisma migrate resolve --applied 20260703173000_init --schema prisma/vercel/schema.prisma",
    "db:vercel:push": "prisma db push --schema prisma/vercel/schema.prisma",
    "db:vercel:studio": "prisma studio --schema prisma/vercel/schema.prisma",
    "db:backfill:patch-test": "tsx prisma/backfill-patch-test-flags.ts",
    "db:backfill:consultation": "tsx prisma/backfill-consultation-flags.ts",
    "test:integration": "node --conditions=react-server --import tsx scripts/verify-production-readiness.ts",
    "test:booking-lifecycle": "node --conditions=react-server --import tsx scripts/verify-booking-lifecycle.ts",
    "test:backend-http": "node --conditions=react-server --import tsx scripts/verify-backend-http.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ],
    "overrides": {
      "postcss": "8.5.28",
      "@prisma/config@6.19.3>deepmerge-ts": "8.0.0"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.35",
    "@prisma/client": "6.19.3",
    "@react-email/components": "^1.0.12",
    "@upstash/ratelimit": "^2.1.0",
    "@upstash/redis": "^1.38.4",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "node-ical": "^0.27.2",
    "otpauth": "^9.5.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.28.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
