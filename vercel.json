{
  "git": {
    "deploymentEnabled": false
  },
  "regions": [
    "lhr1"
  ],
  "routes": [
    {
      "src": "^/(?:.*/)?(?:wp-admin|wp-login|wp-content|wp-includes|wp-json|wp-config|xmlrpc)(?:[/.].*)?$",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "^/.*\\.(?:php\\d?|phtml|asp|aspx|jsp|cgi)(?:/.*)?$",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "^/(?:.*/)?(?:phpinfo|php_info|_profiler)(?:[/.].*)?$",
      "mitigate": {
        "action": "deny"
      }
    },
    {
      "src": "^/(?:.*/)?\\.(?:env|git|svn|hg|aws|ssh|htaccess|htpasswd|DS_Store)(?:[/.].*)?$",
      "mitigate": {
        "action": "deny"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "*/30 8-19 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron/housekeeping",
      "schedule": "15 3 * * *"
    }
  ]
}
