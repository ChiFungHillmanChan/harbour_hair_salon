# Harbour Hair Salon — environment variables
# Copy to .env (local) or set in Vercel Project Settings. Never commit real secrets.

# --- Database ---
# Local dev (SQLite):
DATABASE_URL="file:./dev.db"
# Production (Neon Postgres, auto-injected by the Vercel Neon integration):
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=

# --- Auth (REQUIRED, no fallback) ---
# JWT signing key. Generate a long random value: `openssl rand -base64 48`
SESSION_SECRET=

# --- Email (Resend) ---
RESEND_API_KEY=
# REQUIRED in production. Its domain must be verified in the SAME Resend team
# as RESEND_API_KEY. A Google login does not configure DNS or verify the sender.
EMAIL_FROM="Harbour Hair Salon <bookings@harbourhair.co.uk>"
EMAIL_REPLY_TO=
# Salon inbox that receives the internal new-booking alert:
SALON_NOTIFY_EMAIL=
# Resend audience for the newsletter (optional):
RESEND_AUDIENCE_ID=

# --- Google OAuth (optional; enables "Continue with Google") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Rate limiting (Upstash Redis via Vercel Marketplace) ---
# Both halves required; accepts KV_* (Marketplace) or UPSTASH_* names.
# If unset, rate limiting falls back to a fail-closed in-process window.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Cron ---
# Set a long random secret in Vercel; Vercel sends it in scheduled requests.
CRON_SECRET=

# Explicit opt-in after the sender domain/inbox is verified and migrations applied.
# Both notification routes return before database access when disabled.
# Required before enabling online booking in Admin > Settings.
NOTIFICATIONS_ENABLED=false

# Shared Fresha/Treatwell worker: 15-minute ticks, guarded by saved active-staff
# hours in Europe/London, with a 15-minute buffer before/after. Vercel Pro required.
# Hours are cached and invalidated by Admin > Opening Hours; closed ticks skip work.
# Configure each staff/provider in Admin > Integrations, then enable and test.
# Calendar polling has delay; requests remain PENDING for salon approval.
CALENDAR_SYNC_ENABLED=false

# Independent retention / expired lease recovery. Enable after migrations and retention-policy review.
# Runs daily even when notification delivery is disabled.
HOUSEKEEPING_ENABLED=false

# --- Treatwell inbound iCal sync ---
# Kill-switch for GET /api/cron/treatwell-sync. Anything other than "true"
# makes the route return before it touches the database.
#
# Deliberately OFF, and there is no cron entry in vercel.json to call it. The
# scheduled sync kept Neon's compute awake 24/7 (it never idles the 5 minutes
# needed to suspend) while doing nothing — no stylist has ever had an iCal URL.
# Admin → Integrations → "Test and sync saved feed" works independently of this legacy flag.
#
# Legacy compatibility route only. Use CALENDAR_SYNC_ENABLED and the shared
# /api/cron/calendar-sync schedule for new setup; do not add a second schedule.
TREATWELL_SYNC_ENABLED=

# --- Site ---
# Canonical public URL (used for absolute links, sitemap, OG images).
NEXT_PUBLIC_SITE_URL="https://www.harbourhair.co.uk"
